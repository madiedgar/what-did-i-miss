# Copy to .env and fill in. `.env` is gitignored; never commit real values.
# `npm start` / `npm run seed` load .env automatically (--env-file-if-exists).
# On Railway there is no .env — set these in the service's Variables tab instead.

# --- Telegram (BotFather) ---------------------------------------------------
# /newbot gives you the token. Then /setprivacy -> Disable, or the bot cannot
# see group messages at all and nothing is ever ingested.
TELEGRAM_TOKEN=
# You invent this. Pass the same value to setWebhook as `secret_token`.
TELEGRAM_WEBHOOK_SECRET=
# The demo group's id — a negative number. Add the bot to the group, post a
# message, then read message.chat.id from:
#   https://api.telegram.org/bot<TELEGRAM_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- ElevenLabs -------------------------------------------------------------
# Dashboard -> profile -> API Keys.
ELEVENLABS_API_KEY=
# The agent's page in the dashboard; starts with `agent_`.
ELEVENLABS_AGENT_ID=

# --- Context.dev (verify_information) ---------------------------------------
# Bearer token for api.context.dev.
CONTEXT_DEV_KEY=

# --- Devin ------------------------------------------------------------------
DEVIN_API_KEY=

# --- Secrets you invent -----------------------------------------------------
# Shared secret for every POST /tools/*. This exact value must also be pasted
# as the `x-tool-secret` header on all six webhook tools in the ElevenLabs
# dashboard — a mismatch makes every tool call 401 silently mid-conversation.
TOOL_SECRET=
# Signs the /catchup session links (HS256, 15 min expiry).
SESSION_JWT_SECRET=

# --- Deployment -------------------------------------------------------------
# Public base URL, no trailing slash. Locally: http://localhost:3000
APP_URL=http://localhost:3000

# --- Optional (sensible defaults; listed so they are discoverable) -----------
# SQLite file path. Defaults to ./data.db. On Railway point this INSIDE a
# mounted volume — the container filesystem is ephemeral, so without one every
# redeploy wipes the seeded transcript and all ingested messages.
# DB_PATH=/data/data.db
# PORT=3000
# DEVIN_API_BASE_URL=https://api.devin.ai
